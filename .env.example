# --- Model provider (pick one). Without any key the app runs in offline demo mode. ---
# OpenRouter: one key, any listed model. Cheap, tool-capable picks:
#   openai/gpt-4o-mini (default) · google/gemini-2.5-flash-lite · google/gemini-2.5-flash
#   openai/gpt-4.1-mini · anthropic/claude-haiku-4.5 · deepseek/deepseek-chat-v3-0324
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_SITE_URL=https://your-app.example        # attribution header (optional)
# OPENROUTER_APP_NAME=XPMatch                          # attribution header (optional)
# Anthropic direct (default model: anthropic/claude-opus-5)
# ANTHROPIC_API_KEY=
# Or OpenAI / Google direct
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Google Maps Platform (map panel with recommendation markers) ---
# Browser key: enable "Maps JavaScript API", restrict to your HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key: enable "Places API (New)", restrict to the Places API (never shipped to the browser).
GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from Google Cloud for custom map styling (defaults to DEMO_MAP_ID)
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# PLACES_DEBUG=1                              # log place lookups triggered by the assistant

# Optional overrides
# COPILOT_MODEL=anthropic/claude-opus-5      # "openrouter/<id>", any "provider/model" the AI SDK knows, or "demo"
# COPILOT_EFFORT=medium                       # low | medium | high | xhigh | max (Claude 4.6+/5 only)
# NEXT_PUBLIC_COPILOTKIT_INSPECTOR=true       # show the CopilotKit dev inspector

# Opt out of CopilotKit runtime telemetry
# COPILOTKIT_TELEMETRY_DISABLED=true
